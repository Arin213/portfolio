<%- include('partials/header', { title: 'Projects' }) %>

    <div class="content">
        <div class="text-col">
            <h1>Projects:</h1>

            <% if (projects.length === 0) { %>
                <p>No projects yet — check back soon! This space is reserved for future work.</p>
            <% } else { %>
                <ul>
                <% projects.forEach(function (p) { %>
                    <li>
                        <h3><%= p.title %></h3>
                        <p><%= p.description %></p>
                        <% if (p.tech && p.tech.length) { %>
                            <p><em>Tech:</em> <%= p.tech.join(', ') %></p>
                        <% } %>
                        <% if (p.link) { %><a href="<%= p.link %>">Live demo</a><% } %>
                        <% if (p.repo) { %><a href="<%= p.repo %>">Source</a><% } %>
                    </li>
                <% }); %>
                </ul>
            <% } %>
        </div>
    </div>

<%- include('partials/footer') %>
