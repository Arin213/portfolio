<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Anil Limbu — Web Developer</title>
  <meta name="description"
    content="Portfolio of Anil Limbu, a web developer from Kathmandu building calm, premium web experiences with JavaScript, React, Node.js and Express." />
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%232EC4B6'/><text x='32' y='46' font-family='Arial,Helvetica,sans-serif' font-size='38' font-weight='bold' fill='%23ffffff' text-anchor='middle'>A</text></svg>" />

  <!-- Link previews (LinkedIn, WhatsApp, Slack, X…) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Anil Limbu" />
  <meta property="og:title" content="Anil Limbu — Web Developer" />
  <meta property="og:description"
    content="Portfolio of Anil Limbu, a web developer from Kathmandu building calm, premium web experiences with JavaScript, React, Node.js and Express." />
  <meta property="og:url" content="https://portfolio-02lz.onrender.com/" />
  <meta property="og:image" content="https://portfolio-02lz.onrender.com/photo.jpg" />
  <meta property="og:image:alt" content="Anil Limbu" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Playfair+Display:wght@700;800&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/landing.css" />
</head>

<body>
  <!-- floating background orbs -->
  <div class="bg-orbs">
    <div class="orb o1"></div>
    <div class="orb o2"></div>
    <div class="orb o3"></div>
  </div>

  <!-- custom cursor -->
  <div class="cursor-dot"></div>
  <div class="cursor-ring"></div>

  <!-- main floating card -->
  <main class="landing-card">
    <div class="blob blob-top"></div>
    <div class="blob blob-bottom"></div>

    <nav class="topnav">
      <div class="brand-mark">Anil<span style="color:var(--accent)">.</span></div>
      <div class="nav-links">
        <a href="/">About</a>
        <a href="/resume">Resume</a>
        <a href="/projects">Projects</a>
        <a href="/skills">Skills</a>
        <a href="/hobbies">Hobbies</a>
        <a href="/contact">Contact</a>
      </div>
      <button class="theme-toggle" aria-label="Toggle dark mode" aria-pressed="false"
        title="Switch to dark mode">🌙</button>
    </nav>

    <section class="hero">
      <div class="hero-text">
        <span class="eyebrow">Web Developer</span>
        <h1 class="hero-title">
          <span class="line">Hello,</span>
          <span class="line">My name is</span>
          <span class="line">Anil Limbu</span>
        </h1>
        <p class="hero-desc">
          Passionate about programming, philosophy, and the
          small details that make interfaces feel alive.
        </p>
        <div class="cta-row">
          <a href="/projects" class="btn btn-primary">Projects →</a>
          <a href="https://github.com/Arin213" class="btn btn-secondary" target="_blank"
            rel="noopener noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/arin-limbu-a99674220/" class="btn btn-secondary" target="_blank"
            rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>

      <div class="hero-visual">
        <span class="deco c1"></span><span class="deco c2"></span><span class="deco c3"></span>
        <img class="hero-photo" src="/photo.jpg" alt="Anil Limbu" />
      </div>
    </section>
  </main>

<%- include('partials/siteFooter') %>

  <!-- libraries -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
  <script src="/js/landing.js"></script>
  <script src="/js/cursor.js"></script>
  <script src="/js/theme.js"></script>
</body>

</html>
