<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Anil Limbu — Web Developer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Playfair+Display:wght@700;800&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/landing.css" />
</head>

<body>
  <!-- floating background orbs -->
  <div class="bg-orbs">
    <div class="orb o1"></div>
    <div class="orb o2"></div>
    <div class="orb o3"></div>
  </div>

  <!-- custom cursor -->
  <div class="cursor-dot"></div>
  <div class="cursor-ring"></div>

  <!-- main floating card -->
  <main class="landing-card">
    <div class="blob blob-top"></div>
    <div class="blob blob-bottom"></div>

    <nav class="topnav">
      <div class="brand-mark">Anil<span style="color:var(--accent)">.</span></div>
      <div class="nav-links">
        <a href="/">About</a>
        <a href="/projects">Projects</a>
        <a href="/skills">Skills</a>
        <a href="/hobbies">Hobbies</a>
        <a href="/contact">Contact</a>
      </div>
      <button class="theme-toggle" aria-label="Toggle dark mode">🌙</button>
    </nav>

    <section class="hero">
      <div class="hero-text">
        <span class="eyebrow">Web Developer</span>
        <h1 class="hero-title">
          <span class="line">Hello,</span>
          <span class="line">My name is</span>
          <span class="line">Anil Limbu</span>
        </h1>
        <p class="hero-desc">
          Passionate about programming, philosophy, and the
          small details that make interfaces feel alive.
        </p>
        <div class="cta-row">
          <a href="/projects" class="btn btn-primary">Projects →</a>
          <a href="https://linkedin.com" class="btn btn-secondary">LinkedIn</a>
        </div>
      </div>

      <div class="hero-visual">
        <span class="deco c1"></span><span class="deco c2"></span><span class="deco c3"></span>
        <img class="hero-photo" src="/photo.jpg" alt="Anil Limbu" />
      </div>
    </section>
  </main>

  <!-- premium footer -->
  <footer class="site-footer">
    <div class="footer-blob fb1"></div>
    <div class="footer-blob fb2"></div>
    <svg class="footer-wave" viewBox="0 0 1200 40" preserveAspectRatio="none">
      <defs>
        <linearGradient id="waveGrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#2EC4B6" />
          <stop offset="50%" stop-color="#1B9E92" />
          <stop offset="100%" stop-color="#2EC4B6" />
        </linearGradient>
      </defs>
      <path d="M0,20 C200,40 400,0 600,20 C800,40 1000,0 1200,20" />
    </svg>

    <div class="footer-grid">
      <div>
        <div class="footer-logo">Anil<span>.</span></div>
        <p class="footer-tag">Web Developer &amp; developer building calm, premium web experiences.</p>
        <div class="socials">
          <a href="https://github.com/Arin213" aria-label="GitHub"><img src="/svg/github.svg" alt="GitHub" width="20"
              height="20"></a>
          <a href="https://linkedin.com" aria-label="LinkedIn"><img src="/svg/linkedin.svg" alt="LinkedIn" width="20"
              height="20"></a>
          <a href="mailto:unsung.apricity01@gmail.com" aria-label="Email"><img src="/svg/email.svg" alt="Email"
              width="20" height="20"></a>
        </div>
      </div>
      <div>
        <h4>Explore</h4><a href="/">About</a><a href="/resume">Resume</a><a href="/projects">Projects</a>
      </div>
      <div>
        <h4>More</h4><a href="/contact">Contact</a><a href="/skills">Skills</a><a href="/hobbies">Hobbies</a>
      </div>
      <div>
        <h4>Connect</h4><a href="mailto:unsung.apricity01@gmail.com" aria-label="Email"><img src="/svg/email.svg"
            alt="Email" width="20" height="20"></a><a href="https://linkedin.com" aria-label="LinkedIn"><img
            src="/svg/linkedin.svg" alt="LinkedIn" width="20" height="20"></a><a href="https://github.com/Arin213"
          aria-label="GitHub"><img src="/svg/github.svg" alt="GitHub" width="20" height="20"></a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 Anil Limbu. All rights reserved.</span>
      <button class="contact-pulse" onclick="location.href='/contact'">Get in touch</button>
    </div>
  </footer>

  <!-- libraries -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
  <script>gsap.registerPlugin(ScrollTrigger);</script>
  <script src="/js/landing.js"></script>
  <script src="/js/theme.js"></script>
</body>

</html>